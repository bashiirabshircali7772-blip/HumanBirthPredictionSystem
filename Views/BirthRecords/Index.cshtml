@model List<BirthRecord>
@{
    ViewData["Title"] = "Birth Records";
    ViewData["Subtitle"] = "Historical, official, estimated, and predicted records";
}

<div class="filter-bar">
    <form method="get" style="display:flex; gap:12px; align-items:end; flex:1; flex-wrap:wrap;">
        <div class="form-group">
            <label class="field-label">Country</label>
            @Html.DropDownList("countryId", (SelectList)ViewBag.Countries, "All Countries", new { @class = "form-control" })
        </div>
        <div class="form-group">
            <label class="field-label">Year</label>
            <input type="number" name="year" value="@ViewBag.Year" class="form-control" style="width:110px;" placeholder="Any" />
        </div>
        <div class="form-group">
            <label class="field-label">Record Type</label>
            <select name="recordType" class="form-control">
                <option value="">All Types</option>
                @foreach (RecordType rt in Enum.GetValues(typeof(RecordType)))
                {
                    <option value="@rt" selected="@(ViewBag.RecordType?.ToString() == rt.ToString())">@rt</option>
                }
            </select>
        </div>
        <div class="form-group">
            <label class="field-label">Search</label>
            <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Country or source" />
        </div>
        <button class="btn btn-outline" type="submit">Filter</button>
    </form>
    <a asp-action="Create" class="btn btn-primary">+ Add Record</a>
</div>

<div class="card">
    <div class="table-wrap">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Country</th><th>City</th><th>Year</th>
                    <th class="num">Total</th><th class="num">Male</th><th class="num">Female</th>
                    <th>Type</th><th>Source</th><th></th>
                </tr>
            </thead>
            <tbody>
            @if (!Model.Any())
            {
                <tr><td colspan="9"><div class="empty-state"><h4>No birth records found</h4><p>Add a record or adjust your filters.</p></div></td></tr>
            }
            @foreach (var r in Model)
            {
                <tr>
                    <td><strong>@r.Country?.CountryName</strong></td>
                    <td class="text-soft">@(r.City?.CityName ?? "&mdash;")</td>
                    <td>@r.Year</td>
                    <td class="num">@r.TotalBirths.ToString("N0")</td>
                    <td class="num">@r.MaleBirths.ToString("N0")</td>
                    <td class="num">@r.FemaleBirths.ToString("N0")</td>
                    <td><span class="badge badge-@r.RecordType.ToString().ToLower()">@r.RecordType</span></td>
                    <td class="text-soft" style="max-width:160px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">@r.DataSource</td>
                    <td>
                        <div class="actions-row">
                            <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-outline btn-sm">Edit</a>
                            <form asp-action="Delete" asp-route-id="@r.Id" method="post" data-confirm="Delete this record?">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                            </form>
                        </div>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
