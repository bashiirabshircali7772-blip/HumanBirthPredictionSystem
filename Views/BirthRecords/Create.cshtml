@model BirthRecord
@{
    ViewData["Title"] = "Add Birth Record";
}

<div class="card card-pad" style="max-width:760px;">
    <div asp-validation-summary="All" class="validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="form-group">
                <label class="field-label" asp-for="CountryId">Country</label>
                @Html.DropDownListFor(m => m.CountryId, (SelectList)ViewBag.Countries, "-- Select Country --",
                    new { @class = "form-control", data_country_source = "true", data_city_target = "CityId" })
                <span asp-validation-for="CountryId" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="field-label" asp-for="CityId">City (optional)</label>
                <select asp-for="CityId" id="CityId" class="form-control">
                    <option value="">-- None / Country level --</option>
                </select>
                <span asp-validation-for="CityId" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="field-label" asp-for="Year">Year</label>
                <input asp-for="Year" type="number" class="form-control" />
                <span asp-validation-for="Year" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="field-label" asp-for="RecordType">Record Type</label>
                <select asp-for="RecordType" asp-items="Html.GetEnumSelectList<RecordType>()" class="form-control"></select>
                <span asp-validation-for="RecordType" class="field-error"></span>
            </div>

            <div class="form-group">
                <label class="field-label" asp-for="TotalBirths">Total Births</label>
                <input asp-for="TotalBirths" type="number" min="0" class="form-control" />
                <span asp-validation-for="TotalBirths" class="field-error"></span>
            </div>
            <div class="form-group">
                <div class="form-group" style="margin-bottom:8px;">
                    <label class="field-label" asp-for="MaleBirths">Male Births</label>
                    <input asp-for="MaleBirths" type="number" min="0" class="form-control" />
                    <span asp-validation-for="MaleBirths" class="field-error"></span>
                </div>
                <div class="form-group" style="margin-bottom:0;">
                    <label class="field-label" asp-for="FemaleBirths">Female Births</label>
                    <input asp-for="FemaleBirths" type="number" min="0" class="form-control" />
                    <span asp-validation-for="FemaleBirths" class="field-error"></span>
                </div>
            </div>

            <div class="form-group">
                <label class="field-label" asp-for="DataSource">Data Source</label>
                <input asp-for="DataSource" class="form-control" placeholder="e.g. National Statistics Office" />
            </div>
            <div class="form-group">
                <label class="field-label" asp-for="SourceReference">Source Reference</label>
                <input asp-for="SourceReference" class="form-control" placeholder="e.g. Report URL or citation" />
            </div>
        </div>

        <p class="text-soft" style="font-size:12.5px; margin:-4px 0 14px;">Note: Male Births + Female Births must equal Total Births.</p>

        <div class="actions-row">
            <button type="submit" class="btn btn-primary">Save Record</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
