@model PredictionViewModel
@{
    ViewData["Title"] = "Prediction";
    ViewData["Subtitle"] = "Python + Scikit-learn Linear Regression prediction module";
}

<div class="disclaimer-box">
    <span>&#9888;</span>
    <span>The values displayed in this section are predictive estimates generated by the system based on available historical data. These results should not be interpreted as officially recorded future birth statistics.</span>
</div>

@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<form asp-action="Run" method="post" class="filter-bar">
    @Html.AntiForgeryToken()
    <div class="form-group">
        <label class="field-label">Country</label>
        @Html.DropDownList("CountryId", new SelectList(Model.Countries, "Id", "CountryName", Model.CountryId), "-- Select Country --",
            new { @class = "form-control", data_country_source = "true", data_city_target = "CityId" })
    </div>
    <div class="form-group">
        <label class="field-label">City (optional)</label>
        @Html.DropDownList("CityId", new SelectList(Model.Cities, "Id", "CityName", Model.CityId), "-- None / Country level --",
            new { @class = "form-control", id = "CityId" })
    </div>
    <div class="form-group">
        <label class="field-label">Start Year</label>
        <input type="number" name="StartYear" value="@Model.StartYear" class="form-control" style="width:110px;" />
    </div>
    <div class="form-group">
        <label class="field-label">End Year</label>
        <input type="number" name="EndYear" value="@Model.EndYear" class="form-control" style="width:110px;" />
    </div>
    <button class="btn btn-accent" type="submit">Run Prediction</button>
</form>

@if (Model.HasResults)
{
    <div class="legend-row">
        <span><span class="legend-dot" style="background:#4c5d73;"></span>Historical / Official / Estimated Data</span>
        <span><span class="legend-dot" style="background:#b9812e;"></span>Predicted Data (Model Estimate)</span>
    </div>

    <div class="card" style="margin-bottom:18px;">
        <div class="card-header"><h3>Historical vs Predicted Total Births</h3></div>
        <div class="card-pad"><canvas id="predictionChart" height="100"></canvas></div>
    </div>

    <div class="card">
        <div class="card-header"><h3>Combined Data Table</h3></div>
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Year</th><th>Data Type</th><th class="num">Total Births</th><th class="num">Male</th><th class="num">Female</th></tr></thead>
                <tbody>
                @foreach (var row in Model.CombinedRows)
                {
                    <tr>
                        <td>@row.Year</td>
                        <td>
                            @if (row.DataType == "Predicted")
                            {
                                <span class="badge badge-predicted">Predicted &middot; Model Estimate</span>
                            }
                            else
                            {
                                <span class="badge badge-@row.DataType.ToLower()">@row.DataType &middot; Recorded Data</span>
                            }
                        </td>
                        <td class="num">@row.TotalBirths.ToString("N0")</td>
                        <td class="num">@row.MaleBirths.ToString("N0")</td>
                        <td class="num">@row.FemaleBirths.ToString("N0")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="empty-state">
            <h4>No prediction generated yet</h4>
            <p>Select a country and prediction range above, then click "Run Prediction".</p>
        </div>
    </div>
}

@section Scripts {
@if (Model.HasResults)
{
    <script>
        const rows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CombinedRows));
        const years = rows.map(r => r.year);
        const totals = rows.map(r => r.totalBirths);
        const isPredicted = rows.map(r => r.dataType === 'Predicted');

        const pointColors = isPredicted.map(p => p ? '#b9812e' : '#4c5d73');

        new Chart(document.getElementById('predictionChart'), {
            type: 'line',
            data: {
                labels: years,
                datasets: [{
                    label: 'Total Births',
                    data: totals,
                    borderColor: '#4c5d73',
                    segment: {
                        borderColor: ctx => isPredicted[ctx.p1DataIndex] ? '#b9812e' : '#4c5d73',
                        borderDash: ctx => isPredicted[ctx.p1DataIndex] ? [6, 4] : []
                    },
                    pointBackgroundColor: pointColors,
                    pointBorderColor: pointColors,
                    tension: 0.25
                }]
            },
            options: { plugins: { legend: { display: false } } }
        });
    </script>
}
}
