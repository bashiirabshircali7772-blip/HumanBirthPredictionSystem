@model HumanBirthPredictionSystem.ViewModels.CreateUserViewModel
@{
    ViewData["Title"] = "Add New User";
    ViewData["Subtitle"] = "Create a new user account with role-based permissions";
}

<div class="card" style="max-width: 680px; margin: 0; border-radius: 14px;">
    <div class="card-pad" style="padding: 28px 32px;">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label asp-for="Username" class="field-label" style="font-size: 13px; font-weight: 700; color: var(--navy-950); margin-bottom: 8px;">Username</label>
                <input asp-for="Username" class="form-control" placeholder="e.g. Ahmed" style="padding: 10px 14px;" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="form-group" style="margin-bottom: 20px;">
                <label asp-for="FullName" class="field-label" style="font-size: 13px; font-weight: 700; color: var(--navy-950); margin-bottom: 8px;">Full Name</label>
                <input asp-for="FullName" class="form-control" placeholder="e.g. Ahmed Mohamed (Data Entry)" style="padding: 10px 14px;" />
                <span asp-validation-for="FullName" class="field-error"></span>
            </div>

            <div class="form-group" style="margin-bottom: 24px;">
                <label asp-for="Role" class="field-label" style="font-size: 13px; font-weight: 700; color: var(--navy-950); margin-bottom: 8px;">System Role</label>
                <select asp-for="Role" class="form-control" style="padding: 10px 14px;">
                    <option value="User">User (Data Entry &amp; View Only - Cannot Edit/Delete)</option>
                    <option value="Administrator">Administrator (Full Control)</option>
                </select>
                <span asp-validation-for="Role" class="field-error"></span>
            </div>

            <div style="border-top: 1px dashed #d5d9e5; margin: 24px 0;"></div>

            <div class="form-group" style="margin-bottom: 28px;">
                <label asp-for="Password" class="field-label" style="font-size: 13px; font-weight: 700; color: var(--navy-950); margin-bottom: 8px;">Password</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="Enter password (e.g. user123)" style="padding: 10px 14px;" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div style="display: flex; justify-content: flex-end; align-items: center; gap: 12px; margin-top: 10px;">
                <a asp-action="Index" class="btn btn-outline" style="padding: 9px 22px;">Cancel</a>
                <button type="submit" class="btn btn-primary" style="padding: 9px 24px;">+ Create User</button>
            </div>
        </form>
    </div>
</div>
