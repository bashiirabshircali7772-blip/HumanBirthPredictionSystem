@model City
@{
    ViewData["Title"] = "Add City";
}

<div class="card card-pad" style="max-width:640px;">
    <div asp-validation-summary="ModelOnly" class="validation-summary" style="@(ViewData.ModelState.IsValid ? "display:none" : "")"></div>

    <form asp-action="Create" method="post" novalidate>
        @Html.AntiForgeryToken()
        <div class="form-grid">
            <div class="form-group">
                <label class="field-label" asp-for="CountryId">Country</label>
                @Html.DropDownListFor(m => m.CountryId, (SelectList)ViewBag.Countries, "-- Select Country --", new { @class = "form-control" })
                <span asp-validation-for="CountryId" class="field-error"></span>
            </div>
            <div class="form-group">
                <label class="field-label" asp-for="CityName">City Name</label>
                <input asp-for="CityName" class="form-control" placeholder="e.g. Garowe" />
                <span asp-validation-for="CityName" class="field-error"></span>
            </div>
        </div>
        <div class="actions-row" style="margin-top:8px;">
            <button type="submit" class="btn btn-primary">Save City</button>
            <a asp-action="Index" class="btn btn-outline">Cancel</a>
        </div>
    </form>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
